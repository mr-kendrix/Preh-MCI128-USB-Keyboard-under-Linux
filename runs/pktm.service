# pktm.service — TEMPLATE (not installed; placeholders BEFORE use):
#   <HOME>  = your home; <PMAP> = absolute .pmap path; <CALIB> = calib json (learned via pktd)
# NOTE: vendor .pmaps use WINDOWS process names as <Dependency> — Linux process names
#   NEVER match them; window-specific rules look dead until an alias table maps them (open).
#   (round 15 note: 0/128 rules in Mr.Kendrix.pmap are mixed literal+macro REFUSED,
#    so that gap does not block THIS file; kdotool probe works in the systemd env —
#    pktm injects KDE_SESSION_VERSION itself, verified via systemd-run journal.)
# Trial order: sudo systemctl stop pktd.service (a user unit cannot stop the SYSTEM unit),
#   then start pktm by hand or via this unit. ONE daemon at a time: both = every key twice
#   (pktm refuses while a pktd.py inject lives, and pktd's own scan refuses — r10 parity).
# Rollback: kill pktm, sudo systemctl start pktd.service. NO auto-restart until the
#   exit-sweep trial passed (it HAS: marker tests clean, r13).
[Unit]
Description=pktm live POS-key daemon (trial)

[Service]
ExecStart=<HOME>/hermes-workspace/pkt-editor-cpp/b/pktm --live <PMAP> --calib <CALIB>
Environment=YDOTOOL_SOCKET=/tmp/.ydotool_socket
# stop within 10 s so the SIGTERM exit-sweep releases held keys BEFORE any SIGKILL:
TimeoutStopSec=10
# blunt-but-effective after an abnormal stop (kill -9 mid-hold CAN leave a key down):
# ExecStopPost=/usr/bin/systemctl restart ydotoold.service
